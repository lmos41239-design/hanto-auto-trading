# Use simulation first. Change to kis_demo only after connecting official KIS Open API code.
MODE=simulation

# Samsung Electronics stock code
STOCK_CODE=005930
QUANTITY=1
MA_WINDOW=5

# Do not upload real API keys to GitHub.
APP_KEY=your_mock_app_key_here
APP_SECRET=your_mock_app_secret_here
ACCOUNT_NO=your_mock_account_8_digits_here
ACCOUNT_PRODUCT_CODE=01

.env
__pycache__/
*.pyc
*.pyo
*.log
.venv/
venv/
.DS_Store
